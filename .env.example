API_ADDR=:8080
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/xzxg_shop?parseTime=true&loc=Local
REDIS_ADDR=localhost:6379
QDRANT_URL=http://localhost:6333
ROCKETMQ_ENDPOINT=
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_SMALL_MODEL=qwen3.5-flash
AI_LARGE_MODEL=qwen3.6-plus

# Xunfei realtime speech recognition. Keep real credentials in local .env only.
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_RTASR_BASE_URL=wss://office-api-ast-dx.iflyaisol.com
XUNFEI_RTASR_PATH=/ast/communicate/v1
XUNFEI_RTASR_LANG=autodialect
XUNFEI_RTASR_AUDIO_ENCODE=pcm_s16le
XUNFEI_RTASR_SAMPLE_RATE=16000
